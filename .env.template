# Frontend
REACT_APP_BACKEND_URL=http://localhost:5001

# Backend core
NODE_ENV=production
FLASK_ENV=production
JWT_SECRET_KEY=your_secure_jwt_secret_here

# Database
POSTGRES_DB=koala_db
DATABASE_URL=postgresql+psycopg2://postgres@postgres:5432/koala_db

# Admin bootstrap (optional but recommended)
ADMIN_EMAIL=admin@koala-ui.com
ADMIN_PASSWORD=change-me

# Optional guardrails for shared LLM profile choices
LLM_ALLOWED_PROVIDERS=openrouter,ollama
LLM_ALLOWED_ENDPOINTS=

# Optional service-level fallbacks (profile overrides these)
# LION_LINKER_BASE_URL=https://lion.zooverse.dev
# LION_LINKER_API_KEY=
# LION_LINKER_LAMAPI_ENDPOINT=https://lamapi.hel.sintef.cloud/lookup/entity-retrieval
# LION_LINKER_LAMAPI_TOKEN=
# LION_LINKER_LAMAPI_NUM_CANDIDATES=10
# LION_LINKER_LAMAPI_KG=wikidata
# CROCODILE_BASE_URL=https://crocodile.zooverse.dev
# CROCODILE_API_KEY=
# MOOSE_BASE_URL=https://moose.zooverse.dev
# MOOSE_API_KEY=
# LLM_API_KEY=
# LLM_ENDPOINT=

# Build/runtime versions
NODE_VERSION=22
PYTHON_VERSION=3.14
POSTGRES_VERSION=18

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5001
POSTGRES_PORT=5432
